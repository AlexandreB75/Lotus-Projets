{
  "name": "04. Sync Steps Chatwoot → CRM",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "b2000001-0000-0000-0000-000000000001",
      "name": "Webhook — Step change",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "path": "crm-step-sync",
        "method": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "b2000001-sync"
    },
    {
      "id": "b2000001-0000-0000-0000-000000000002",
      "name": "Extrair phone e step_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "jsCode": "// Suporta dois formatos:\n// 1. Chamada direta do Hermes XD: { phone, step_id }\n// 2. Webhook Chatwoot nativo: { data: { meta: { sender: { phone_number } }, current_task: { step_id } } }\nconst body = $input.first().json.body || $input.first().json;\n\nlet phone = body.phone;\nlet step_id = body.step_id;\n\nif (!phone && body.data) {\n  phone = body.data?.meta?.sender?.phone_number;\n  step_id = body.data?.current_task?.step_id;\n}\n\nif (!phone || step_id === undefined) {\n  throw new Error('phone e step_id obrigatorios. Recebido: ' + JSON.stringify(body).slice(0, 200));\n}\n\nreturn [{ json: { phone, step_id: Number(step_id) } }];"
      }
    },
    {
      "id": "b2000001-0000-0000-0000-000000000003",
      "name": "Atualizar CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BASE_URL }}/api/webhook/chatwoot",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ phone: $json.phone, step_id: $json.step_id }) }}"
      }
    },
    {
      "id": "b2000001-0000-0000-0000-000000000004",
      "name": "Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, crm: $json }) }}"
      }
    }
  ],
  "connections": {
    "Webhook — Step change": {
      "main": [[{ "node": "Extrair phone e step_id", "type": "main", "index": 0 }]]
    },
    "Extrair phone e step_id": {
      "main": [[{ "node": "Atualizar CRM", "type": "main", "index": 0 }]]
    },
    "Atualizar CRM": {
      "main": [[{ "node": "Responder 200", "type": "main", "index": 0 }]]
    }
  }
}
