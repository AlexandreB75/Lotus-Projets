{
  "name": "03. SDR Hilton — Outbound WhatsApp",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "a1000001-0000-0000-0000-000000000001",
      "name": "Gatilho a cada 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000002",
      "name": "Leads nao processados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "ia_processed_at", "value": "is.null" },
            { "name": "limit", "value": "10" },
            { "name": "order", "value": "created_at.asc" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_KEY }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000003",
      "name": "Separar leads em itens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "jsCode": "const leads = $input.first().json;\nif (!Array.isArray(leads) || leads.length === 0) {\n  return [];\n}\nreturn leads.map(lead => ({ json: lead }));"
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000004",
      "name": "Extrair campos do lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [900, 300],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "lead_id", "value": "={{ $json.id }}", "type": "string" },
            { "id": "f2", "name": "lead_nome", "value": "={{ $json.nome }}", "type": "string" },
            { "id": "f3", "name": "lead_whatsapp", "value": "={{ $json.whatsapp }}", "type": "string" },
            { "id": "f4", "name": "lead_profissao", "value": "={{ $json.profissao || '' }}", "type": "string" },
            { "id": "f5", "name": "lead_especialidade", "value": "={{ $json.especialidade_medica || '' }}", "type": "string" },
            { "id": "f6", "name": "lead_cidade", "value": "={{ $json.cidade || '' }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000005",
      "name": "GPT-4o mini Classificar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.OPENAI_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0.7, messages: [ { role: 'system', content: 'Você é um classificador de leads imobiliários. Retorne APENAS JSON válido (sem markdown) com: {\"perfil\": \"medico|investidor_renda|segunda_moradia|empresario_sede|outro\", \"produto_alvo\": \"Centro Médico Hilton|Hilton Residencial Pool|Hilton Residencial|Lótus Business\", \"mensagem_abertura\": \"mensagem WhatsApp\"}. Roteamento: Médico/Clínica→Centro Médico Hilton; Investidor renda→Hilton Residencial Pool; Família/Executivo→Hilton Residencial; Advogado/Contador/Imobiliária/Empresário sede→Lótus Business. Mensagem: use primeiro nome, cite profissão, apresente produto, termine com pergunta qualificadora, máximo 5 linhas, assine: Alexandre Borges CRECI-SC 45148.' }, { role: 'user', content: 'Nome: ' + $json.lead_nome + '\\nProfissão: ' + $json.lead_profissao + '\\nEspecialidade: ' + $json.lead_especialidade + '\\nCidade: ' + $json.lead_cidade } ] }) }}"
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000006",
      "name": "Parse resposta OpenAI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300],
      "parameters": {
        "jsCode": "const content = $input.first().json.choices[0].message.content;\nlet cl;\ntry {\n  cl = JSON.parse(content.replace(/```json\\n?|\\n?```/g, '').trim());\n} catch(e) {\n  cl = { perfil: 'outro', produto_alvo: 'Hilton Residencial', mensagem_abertura: 'Olá! Sou Alexandre Borges, CRECI-SC 45148. Tenho uma oportunidade em Itapema. Você busca investimento ou moradia?' };\n}\nconst lead = $('Extrair campos do lead').first().json;\nreturn [{ json: { lead_id: lead.lead_id, lead_nome: lead.lead_nome, lead_whatsapp: lead.lead_whatsapp, perfil: cl.perfil, produto_alvo: cl.produto_alvo, mensagem_abertura: cl.mensagem_abertura } }];"
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000007",
      "name": "Buscar contato Chatwoot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CHATWOOT_URL }}/api/v1/accounts/1/contacts/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "q", "value": "={{ $json.lead_whatsapp }}" },
            { "name": "page", "value": "1" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "api_access_token", "value": "={{ $env.CHATWOOT_TOKEN }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000008",
      "name": "Contato ja existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1780, 300],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.meta.count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000009",
      "name": "Usar contato existente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 180],
      "parameters": {
        "jsCode": "const contact = $input.first().json.payload[0];\nconst lead = $('Parse resposta OpenAI').first().json;\nreturn [{ json: { ...lead, contact_id: contact.id } }];"
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000010",
      "name": "Criar contato Chatwoot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 420],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHATWOOT_URL }}/api/v1/accounts/1/contacts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "api_access_token", "value": "={{ $env.CHATWOOT_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ name: $('Parse resposta OpenAI').first().json.lead_nome, phone_number: $('Parse resposta OpenAI').first().json.lead_whatsapp, inbox_id: 2 }) }}"
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000011",
      "name": "Set contact_id novo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 420],
      "parameters": {
        "jsCode": "const created = $input.first().json;\nconst lead = $('Parse resposta OpenAI').first().json;\nreturn [{ json: { ...lead, contact_id: created.id } }];"
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000012",
      "name": "Criar conversa Chatwoot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2440, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHATWOOT_URL }}/api/v1/accounts/1/conversations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "api_access_token", "value": "={{ $env.CHATWOOT_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ inbox_id: 2, contact_id: $json.contact_id, status: 'open', additional_attributes: { perfil: $json.perfil, produto_alvo: $json.produto_alvo } }) }}"
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000013",
      "name": "Enviar mensagem WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2660, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHATWOOT_URL }}/api/v1/accounts/1/conversations/{{ $json.id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "api_access_token", "value": "={{ $env.CHATWOOT_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ content: $('Parse resposta OpenAI').first().json.mensagem_abertura, message_type: 'outgoing', private: false }) }}"
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000014",
      "name": "Marcar lead processado Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2880, 300],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "=eq.{{ $('Parse resposta OpenAI').first().json.lead_id }}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ ia_processed_at: new Date().toISOString(), resumo_ia: $('Parse resposta OpenAI').first().json.produto_alvo + ' | ' + $('Parse resposta OpenAI').first().json.perfil, status: 'em_contato' }) }}"
      }
    }
  ],
  "connections": {
