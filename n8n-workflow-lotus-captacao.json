        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 300,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Você é o assistente de vendas do Lótus Business — o maior centro empresarial premium do litoral catarinense, em Itapema SC. Salas comerciais de 61m² a 904m², entrega 2028, financiamento direto pela construtora.\\n\\nUm lead acabou de preencher o formulário da landing page.\\n\\nDados:\\n- Nome: {{ $json.nome }}\\n- Perfil de interesse: {{ $json.perfil }}\\n\\nGere APENAS a mensagem de WhatsApp de primeiro contato. Máximo 4 linhas. Tom consultivo e sofisticado, nunca genérico ou agressivo. Use o nome da pessoa. Não use emojis em excesso. Deve soar como alguém que entende o perfil dela.\"\n  }]\n}",
        "options": {}
      },
      "id": "3c4d5e6f-7a8b-9012-cdef-123456789012",
